# Copy to .env.local for local development. Set the same two variables in Vercel for production.
# Both are SERVER-ONLY (no NEXT_PUBLIC_ prefix) and are never sent to the browser.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → service_role (secret). Never commit this value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
